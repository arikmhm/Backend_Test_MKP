# Salin menjadi .env lalu sesuaikan:
#   cp .env.example .env
#   set -a; source .env; set +a
#   go run ./cmd/api

DATABASE_URL=postgres://postgres:password@localhost:5432/mkp_cinema?sslmode=disable

# Wajib diisi, minimal 32 karakter. Buat yang acak: openssl rand -base64 48
JWT_SECRET=ganti-dengan-kunci-acak-minimal-32-karakter

TOKEN_TTL=8h

# Zona waktu sesi database, dipakai penyaring ?date= pada daftar jadwal.
APP_TIMEZONE=Asia/Jakarta

PORT=8080
