    <mxCell id="T4x4t2Cwh6Y3n1j0stwZ-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" value="Notification provider (eksternal)&#10;email / WhatsApp / push" vertex="1">
