    <mxCell id="T4x4t2Cwh6Y3n1j0stwZ-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=12;" value="&lt;b&gt;PostgreSQL PRIMARY&lt;/b&gt;&#10;otoritas kebenaran&#10;semua tulisan kursi &amp;amp; uang" vertex="1">
      <mxGeometry height="80" width="230" x="1250" y="590" as="geometry" />
    </mxCell>
    <mxCell id="T4x4t2Cwh6Y3n1j0stwZ-20" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Read replica - belum dipakai.&lt;/b&gt;&lt;br&gt;Ditambahkan saat query laporan mulai mengganggu penjualan, bukan karena volume transaksi.&lt;br&gt;Kalaupun ditambahkan, hanya untuk laporan - tidak untuk keputusan kursi (&lt;i&gt;replication lag&lt;/i&gt;)." vertex="1">
      <mxGeometry height="80" width="440" x="870" y="681.5" as="geometry" />
    </mxCell>
    <mxCell id="T4x4t2Cwh6Y3n1j0stwZ-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" value="Payment Gateway (eksternal)&#10;Midtrans / Xendit" vertex="1">
      <mxGeometry height="60" width="250" x="1750" y="590" as="geometry" />
