    <mxCell id="T4x4t2Cwh6Y3n1j0stwZ-15" parent="1" style="text;html=1;fontSize=11;fontColor=#666666;align=center;fontStyle=2" value="Dipisah menjadi service tersendiri kalau dibutuhkan, tidak langsung dari awal.&lt;br&gt;&lt;b&gt;Kotak hijau = cakupan Poin C:&lt;/b&gt; API login (auth) + API CRUD jadwal tayang (catalog)." vertex="1">
