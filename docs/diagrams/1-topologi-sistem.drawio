    </mxCell>
    <mxCell id="T4x4t2Cwh6Y3n1j0stwZ-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="&lt;b&gt;Monitoring &amp;amp; alert&lt;/b&gt;&#10;refund FAILED · selisih pencocokan" vertex="1">
      <mxGeometry height="60" width="270" x="1675" y="960" as="geometry" />
    </mxCell>
    <mxCell id="T4x4t2Cwh6Y3n1j0stwZ-24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;fontSize=11;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;CATATAN BEBAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Beban terberat bukan dari banyaknya bioskop, tapi dari &lt;b&gt;banyaknya orang yang membuka denah kursi untuk satu jadwal yang sama&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Satu studio berisi sekitar 200 kursi, dan saat premiere bisa dilihat ratusan orang sekaligus. Pembacaan denah kursi jauh lebih banyak daripada pembelian, karena satu orang membuka denah berkali-kali sebelum memutuskan.&lt;br&gt;&lt;br&gt;-&amp;gt; Pembacaan dilayani &lt;b&gt;Redis&lt;/b&gt;, penulisan (penahanan kursi dan penjualan) ke &lt;b&gt;PostgreSQL primary&lt;/b&gt;." vertex="1">
      <mxGeometry height="180" width="440" x="870" y="780" as="geometry" />
    </mxCell>
    <mxCell id="T4x4t2Cwh6Y3n1j0stwZ-25" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=11;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;KESIMPULAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bagian tersulit dari sistem ini bukan &lt;b&gt;banyaknya&lt;/b&gt; transaksi, tapi &lt;b&gt;rebutan kursi yang sama pada waktu yang sama&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Karena itu rancangan ini menitikberatkan cara memastikan satu kursi tidak bisa punya dua pemilik lewat PRIMARY KEY, transaksi database, dan idempotency bukan pada menambah jumlah server." vertex="1">
      <mxGeometry height="140" width="440" x="870" y="980" as="geometry" />
    </mxCell>
